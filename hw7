#include <iostream>
using namespace std;

class Vehicle {
public:
    const char* name;

    virtual void Print() {
        cout << "Vehicle: " << name << endl;
    }
};

class Bike : public Vehicle {
public:
    void Print() override {
        cout << "Bike: " << name << endl;
    }
};

class Car : public Vehicle {
public:
    void Print() override {
        cout << "Car: " << name << endl;
    }
};

class Bus : public Vehicle {
public:
    void Print() override {
        cout << "Bus: " << name << endl;
    }
};

class Truck : public Vehicle {
public:
    void Print() override {
        cout << "Truck: " << name << endl;
    }
};

int main() {
    Bike b;
    b.name = "Trek";

    Car c;
    c.name = "Toyota";

    Bus bus;
    bus.name = "Mercedes";

    Truck t;
    t.name = "Volvo";

    Vehicle* arr[4] = { &b, &c, &bus, &t };

    for (int i = 0; i < 4; i++) {
        arr[i]->Print();
    }

    return 0;
}
