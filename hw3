#include <iostream>
using namespace std;

double vseh(int a[], int n) {
    double s = 0;
    for (int i = 0; i < n; i++) {
        s = s + a[i];
    }
    return s / n;
}

double otric(int a[], int n) {
    double s = 0;
    int k = 0;
    for (int i = 0; i < n; i++) {
        if (a[i] < 0) {
            s = s + a[i];
            k = k + 1;
        }
    }
    if (k == 0) return 0;
    return s / k;
}

double polozh(int a[], int n) {
    double s = 0;
    int k = 0;
    for (int i = 0; i < n; i++) {
        if (a[i] > 0) {
            s = s + a[i];
            k = k + 1;
        }
    }
    if (k == 0) return 0;
    return s / k;
}

int main() {
    // static
    int a[5] = { 2, -4, 6, -2, 0 };
    cout << vseh(a, 5) << " " << otric(a, 5) << " " << polozh(a, 5) << endl;

    // dinamik
    int* b = new int[4] { 5, -5, 10, 0 };
    cout << vseh(b, 4) << " " << otric(b, 4) << " " << polozh(b, 4) << endl;

    delete[] b;
    return 0;
}
