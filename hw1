#include <iostream>

using namespace std;

class Search {
public:
    int Linear(int arr[], int size, int target) {
        for (int i = 0; i < size; i++) {
            if (arr[i] == target) {
                return i;
            }
        }
        return -1;
    }

    
    int Binary(int arr[], int size, int target) {
        int left = 0;
        int right = size - 1;

        while (left <= right) {
            int mid = left + (right - left) / 2;

            if (arr[mid] == target) {
                return mid;
            }
            if (arr[mid] < target) {
                left = mid + 1;
            } else {
                right = mid - 1;
            }
        }

        return -1;
    }
};

int main() {
    setlocale(LC_ALL, "Russian");

    Search searcher;

    
    int arr[] = { 3, 8, 12, 19, 25, 34, 42, 56 };
    int size = sizeof(arr) / sizeof(arr[0]);

    int target;
    cout << "number to search: ";
    cin >> target;

    int linearIndex = searcher.Linear(arr, size, target);
    if (linearIndex != -1) {
        cout << "Linear: еlement yes index " << linearIndex << endl;
    } else {
        cout << "Linear: element no search" << endl;
    }

    int binaryIndex = searcher.Binary(arr, size, target);
    if (binaryIndex != -1) {
        cout << "Binary: element naydeno index " << binaryIndex << endl;
    } else {
        cout << "Binary: element no search" << endl;
    }

    return 0;
}
